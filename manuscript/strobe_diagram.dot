digraph inclusion_exclusion {
  rankdir=TB;
  labelloc="t"; label="STROBE Flow Diagram: Clinician Inclusion and Exclusion Pathway"; fontsize=12;
  node [fontname=Helvetica, shape=box, width=3.5, fontsize=10];
  
  N1 [label="Initial Scraped PE Roster\n(n = 1,537)"];
  N2 [label="Unique NPI Verified\n(n = 1,279)"];
  N3 [label="OB-GYN Generalist Only\n(n = 1,021)"];
  N4 [label="De-clustered (1/Office)\n(n = 544)"];
  N5 [label="Geographically Matched\n(n = 544 pairs)"];
  N6 [label="Fielded Cohort\n(n = 200 pairs)"];
  
  E1 [label="258 names unmatched/retired", style=dashed];
  E2 [label="258 subspecialists excluded", style=dashed];
  E3 [label="477 clinicians excluded", style=dashed];
  E4 [label="344 matched pairs reserved", style=dashed];
  
  N1 -> N2;
  N2 -> N3;
  N3 -> N4;
  N4 -> N5;
  N5 -> N6;
  
  N1 -> E1 [style=dashed];
  N2 -> E2 [style=dashed];
  N3 -> E3 [style=dashed];
  N5 -> E4 [style=dashed];
}
